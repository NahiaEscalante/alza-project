{
  "name": "@alza/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:dist": "node dist/scripts/migrate.js",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "create-admin:dist": "node dist/scripts/create-admin.js",
    "eval": "tsx src/scripts/eval.ts",
    "eval:generate": "tsx src/scripts/eval-generate.ts",
    "render:preview": "tsx src/render/preview.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@hono/node-server": "^2.1.6",
    "@resvg/resvg-js": "^2.6.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "groq-sdk": "^1.6.0",
    "hono": "^4.13.17",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
