# ALZA · variables de entorno
# Copia este archivo a .env (en la raíz del repositorio) y completa los valores.
# Nunca subas .env al repositorio. Una variable vacía cuenta como no definida.

# --- Servidor -------------------------------------------------------------
# development | test | production. Los scripts lo fijan solos (`npm start` usa production).
# NODE_ENV=
PORT=3000
# fatal | error | warn | info | debug | trace | silent (por defecto: info; silent en pruebas)
LOG_LEVEL=info
# URL pública de la web; se usa para armar los enlaces de los mensajes.
APP_BASE_URL=http://localhost:5173

# --- Base de datos ----------------------------------------------------------
# Valores locales de docker-compose.yml (solo desarrollo, no son secretos).
DATABASE_URL=postgres://alza:alza@localhost:5433/alza
# Base de las pruebas: se borra y se migra en cada `npm test`. Debe terminar en _test.
DATABASE_URL_TEST=postgres://alza:alza@localhost:5433/alza_test

# --- Cifrado ----------------------------------------------------------------
# 32 bytes en base64 para AES-256-GCM. Genera una con: openssl rand -base64 32
ENCRYPTION_KEY=

# --- IA (opcional al arrancar) -------------------------------------------------
# Una o varias llaves de Gemini: GEMINI_API_KEY y/o GEMINI_API_KEY_1..N (se rotan en orden).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY=

# --- WhatsApp Cloud API (Fase 10; las cuatro o ninguna) -------------------------
WHATSAPP_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Canal simulado ---------------------------------------------------------
# true | false. Por defecto: true fuera de producción.
SIMULATOR_ENABLED=true

# --- 360dialog sandbox (opcional; no admite archivos por ID) -----------------
# Para seleccionarlo: WHATSAPP_PROVIDER=dialog360 y SIMULATOR_ENABLED=false.
WHATSAPP_PROVIDER=meta
DIALOG360_API_KEY=
# Secreto independiente para autenticar la URL del webhook (mínimo 32 caracteres).
DIALOG360_WEBHOOK_TOKEN=
